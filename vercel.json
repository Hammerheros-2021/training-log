{
  "functions": {
    "api/claude.js": {
      "maxDuration": 300
    },
    "api/transcribe.js": {
      "maxDuration": 60
    },
    "api/plan.js": {
      "maxDuration": 300
    },
    "api/tts.js": {
      "maxDuration": 30
    },
    "api/route.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.(js|html|json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/deck/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}